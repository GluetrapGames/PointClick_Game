        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"Trying a new defrosting process today for Gaz. Hoping it will keep
          his body nice and supple for reformation."'
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0

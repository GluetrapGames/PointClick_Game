        typeString: CustomFieldType_Actor
      - title: Conversant
        value: -1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"Martin passed today, can''t believe the medicine didn''t work. All
          he wanted was to skip and frolic in Partick, so we''re scattering him there.
          He was such a loving son. Never made any mess, always polite. His heart
          will go on."'
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 23
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 23
        originDialogueID: 1
        destinationConversationID: 23
        destinationDialogueID: 2
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 160
        y: 80
        width: 160
        height: 30
    - id: 2
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 7
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: -1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"New adoption on the way. Me and Debbie are ecstatic! After the accident,
          we didn''t think we''d be allowed anymore... but thankfully our application
          passed! Oh what a joyous day!"'
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 23
      isRoot: 0
      isGroup: 0
      nodeColor: 

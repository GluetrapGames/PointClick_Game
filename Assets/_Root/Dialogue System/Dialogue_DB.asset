        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"Shopping list: stuffing, beef mince, tatties, skintoned thread,
          air freshener (It''s been getting stale in the work room), eggs, milk,
          tennents"'
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 

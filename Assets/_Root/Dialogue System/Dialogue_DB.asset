        value: -1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: '"Major success today. My curly boy has been reborn an immortalised.
          I miss him so much. I''ve kept all his major organs in the freezer next
          to Gaz,  so that we can use them later."'
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
